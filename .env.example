# CrimeVision AI – Environment Configuration

# 1. Google Gemini API Key (Recommended: native image/audio/video multimodal + free tier at https://aistudio.google.com)
GEMINI_API_KEY=

# Gemini Model Identifier (gemini-1.5-flash or gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# 2. Anthropic Claude API Key (Optional secondary provider)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# External Database URL (Optional: e.g. postgresql://user:pass@host:5432/dbname; defaults to SQLite if omitted)
DATABASE_URL=

# Local Server Port (Defaults to 8000)
PORT=8000
